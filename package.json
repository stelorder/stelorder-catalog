{
  "name": "@stelsolutions/stelorder-catalog",
  "version": "1.4.0",
  "scripts": {
    "prettier:format": "prettier --write --parser typescript '**/*.{ts,tsx}'",
    "prettier:check": "prettier --check --parser typescript '**/*.{ts,tsx}'",
    "lint:fix": "eslint . --fix --ext .ts,.tsx --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern dist --ignore-pattern scripts",
    "lint": "eslint . --ext .ts,.tsx --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern dist --ignore-pattern scripts",
    "build": "tsc && vite build",
    "build:local": "tsc && vite build --config vite.config.local.ts",
    "generate:catalog": "node scripts/generate-catalog-manifest.mjs"
  },
  "keywords": [],
  "author": "stelorder",
  "license": "GPL-2.0-or-later",
  "description": "STEL Order Catalog is a modular React component library powered by Vite and TypeScript, with strongly typed, scalable components for distribution and reuse.",
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0",
    "styled-components": ">=6.1.19"
  },
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "msw": "^2.10.5",
    "playwright": "1.55.0",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "rollup-plugin-visualizer": "^6.0.3",
    "vite": "^7.1.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-beta.4",
    "@emotion/styled": "^11.14.1",
    "@mui/styled-engine": "^7.3.3",
    "@mui/x-charts": "^8.14.1",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "polished": "^4.3.1"
  }
}
